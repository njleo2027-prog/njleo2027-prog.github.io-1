<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Nivin Jaison – Civil Engineering Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,600..800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  color-scheme:light;--bg:#FFFFFF;--surface:#F6F9FD;--ink:#0F1B2D;--muted:#51647F;--navy:#0B2A5B;--blue:#1769D1;--line:#C9D6E8;--hi:#F2B705;--grid:rgba(23,105,209,.09);
  --head:"Archivo","Arial Narrow",Arial,sans-serif;--body:"IBM Plex Sans",system-ui,Arial,sans-serif;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.6 var(--body)}
a{color:var(--blue)}a:focus-visible{outline:3px solid var(--hi);outline-offset:3px}
.wrap{max-width:68rem;margin:0 auto;padding:0 1.5rem}
h1,h2,h3{font-family:var(--head);color:var(--navy);margin:0;line-height:1.05}
/* hero */
.hero{background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:32px 32px;border-bottom:1px solid var(--line);padding:5rem 0 4rem}
.hero h1{font-size:clamp(3rem,10vw,7rem);font-stretch:75%;font-weight:800;letter-spacing:-.02em}
.hero .roles{font-size:1.25rem;margin:1.25rem 0 0;font-weight:500}
.hero .sub{color:var(--muted);margin:.25rem 0 0}
.avail{display:inline-block;margin-top:2rem;padding:.6rem 1rem;background:var(--hi);color:#0F1B2D;font-weight:600;border-radius:2px}
.tag{margin-top:2.5rem;color:var(--muted);font-style:italic}
nav{display:flex;gap:1.25rem;flex-wrap:wrap;margin-top:2.5rem}
nav a{color:var(--navy);font-weight:600;text-decoration:none;border-bottom:2px solid var(--line)}
nav a:hover{border-color:var(--blue)}
/* sections */
section{padding:4rem 0;border-bottom:1px solid var(--line)}
h2{font-size:clamp(1.8rem,4vw,2.6rem);font-stretch:80%;font-weight:800;margin-bottom:1.5rem}
.about{display:grid;grid-template-columns:1fr 14rem;gap:3rem;align-items:start}
.avatar{width:14rem;aspect-ratio:1;border-radius:50%;object-fit:cover;border:3px solid var(--navy)}
.skills{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:2rem;margin-top:2.5rem}
.skills h3,.proj h3{font-size:1.25rem;font-stretch:90%;margin-bottom:.5rem}
ul{margin:0;padding-left:1.1rem}li{margin:.2rem 0}
.strengths{columns:2;column-gap:3rem;margin-top:1rem}
.strengths li{break-inside:avoid}
/* projects */
.proj{display:grid;grid-template-columns:1.1fr 1fr;gap:2.5rem;padding:2.5rem 0;border-top:1px solid var(--line)}
.proj:first-of-type{border-top:0;padding-top:0}
.proj h3{font-size:1.7rem;font-stretch:80%;font-weight:800}
.proj .kind{color:var(--muted);margin:.25rem 0 1rem}
dl{display:grid;grid-template-columns:auto 1fr;gap:.35rem 1.25rem;margin:0 0 1.25rem}
dt{font-weight:600;color:var(--navy)}dd{margin:0}
.fig{background:var(--surface);border:1px solid var(--line);padding:.5rem;display:grid;grid-template-columns:1fr 1fr;gap:.5rem;align-content:start}
.fig img{width:100%;height:auto;display:block;background:#fff}
.fig .w{grid-column:1/-1}
.fig figcaption{display:none}
/* contact */
.contact{display:grid;grid-template-columns:1fr 1fr;gap:3rem}
.contact p{margin:.4rem 0}
.lang{display:grid;grid-template-columns:6rem 1fr 5.5rem;gap:.75rem;align-items:center;margin:.6rem 0}
.bar{height:.6rem;background:var(--line);border-radius:1px}.bar i{display:block;height:100%;background:var(--navy)}
.motto{font:700 clamp(1.4rem,3vw,2rem)/1.25 var(--head);font-stretch:85%;color:var(--navy);margin-top:3rem;max-width:36rem}
footer{padding:2rem 0 3rem;color:var(--muted);font-size:.9rem}
.note{margin:-.5rem 0 2rem;padding:.75rem 1rem;border-left:4px solid var(--hi);background:var(--surface);color:var(--muted);font-size:.95rem;max-width:44rem}
@media (max-width:760px){.about,.proj,.contact{grid-template-columns:1fr}.avatar{width:9rem;order:-1}.strengths{columns:1}.hero{padding:3rem 0}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
